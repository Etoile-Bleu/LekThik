# Copy this file to .env and fill it in. It is never read by the server directly: your MCP
# client (Claude Code, Claude Desktop) is the one that loads it and passes these as the process's
# environment when it starts the server. See README.md for exactly how.

# Where your LekThik backend answers. The local dev stack's default; change it for a deployed one.
LEKTHIK_API_URL=http://localhost:8080

# The LekThik account these tools act as. Every workspace, board, list and card they touch
# belongs to this account, exactly as if it had signed in itself.
LEKTHIK_EMAIL=
LEKTHIK_PASSWORD=
